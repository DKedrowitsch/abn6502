set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)

set(CH32_TOOLCHAIN_PREFIX "riscv64-elf-" CACHE STRING "RISC-V toolchain command prefix")
set(CMAKE_C_COMPILER "${CH32_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_ASM_COMPILER "${CH32_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_OBJCOPY "${CH32_TOOLCHAIN_PREFIX}objcopy" CACHE FILEPATH "objcopy")
set(CMAKE_SIZE "${CH32_TOOLCHAIN_PREFIX}size" CACHE FILEPATH "size")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
